{
  "info": {
    "name": "RDAM API v1",
    "description": "Colección Postman — RDAM Backend. Campus de Verano 2026 | Serovich Emilio",
    "_postman_id": "rdam-api-collection-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/v1" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "solicitud_id", "value": "1" },
    { "key": "pago_id", "value": "1" },
    { "key": "cert_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Ciudadano",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('access_token', json.accessToken);",
                "pm.collectionVariables.set('refresh_token', json.refreshToken);",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Tiene access_token', () => pm.expect(json.accessToken).to.be.a('string'));",
                "pm.test('Portal es CIUDADANO', () => pm.expect(json.portal).to.eql('CIUDADANO'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"mgarcia@email.com\",\n  \"password\": \"Password1!\"\n}"
            }
          }
        },
        {
          "name": "Login Admin/Gestor",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('access_token', json.accessToken);",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Portal es ADMIN', () => pm.expect(json.portal).to.eql('ADMIN'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"lmartinez@rdam.gob.ar\",\n  \"password\": \"Password1!\"\n}"
            }
          }
        },
        {
          "name": "Registro Ciudadano",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"jperez@email.com\",\n  \"password\": \"Password1!\",\n  \"dniCuil\": \"20-44444444-4\",\n  \"telefono\": \"011-1234-5678\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Login Ciudadano en Portal Admin (debe fallar 403)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 403', () => pm.response.to.have.status(403));",
                "pm.test('Code FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"mgarcia@email.com\",\n  \"password\": \"Password1!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Usuarios",
      "item": [
        {
          "name": "Mi Perfil (GET /me)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Tiene email', () => pm.expect(pm.response.json().email).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/usuarios/me"
          }
        },
        {
          "name": "Listar Usuarios (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/usuarios?page=1&limit=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Crear Usuario Interno",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Rodríguez\",\n  \"email\": \"arodriguez@rdam.gob.ar\",\n  \"password\": \"TempPass123!\",\n  \"dniCuil\": \"27-55555555-5\",\n  \"rol\": \"GESTOR\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Solicitudes",
      "item": [
        {
          "name": "Crear Solicitud (ciudadano)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('solicitud_id', json.id);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Estado PENDIENTE_REVISION', () => pm.expect(json.estado).to.eql('PENDIENTE_REVISION'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/solicitudes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoCert\": \"LIBRE_DEUDA\",\n  \"urgencia\": \"NORMAL\",\n  \"observaciones\": \"Necesito el certificado para trámite bancario\"\n}"
            }
          }
        },
        {
          "name": "Mis Solicitudes (ciudadano)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/solicitudes/mis"
          }
        },
        {
          "name": "Bandeja Interna (gestor/admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/solicitudes?estado=PENDIENTE_REVISION&page=1&limit=20",
              "query": [
                { "key": "estado", "value": "PENDIENTE_REVISION" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Ver Solicitud por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/solicitudes/{{solicitud_id}}"
          }
        },
        {
          "name": "Tomar Solicitud (gestor)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Estado EN_REVISION', () => pm.expect(pm.response.json().estado).to.eql('EN_REVISION'));"
              ]
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/solicitudes/{{solicitud_id}}/tomar"
          }
        },
        {
          "name": "Aprobar Solicitud (gestor)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Estado PENDIENTE_PAGO', () => pm.expect(pm.response.json().estado).to.eql('PENDIENTE_PAGO'));"
              ]
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/solicitudes/{{solicitud_id}}/aprobar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comentario\": \"Documentación completa y válida\"\n}"
            }
          }
        },
        {
          "name": "Rechazar Solicitud (gestor)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/solicitudes/{{solicitud_id}}/rechazar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivoRechazo\": \"Documentación incompleta. Falta comprobante de domicilio.\",\n  \"comentario\": \"Se notificó al ciudadano\"\n}"
            }
          }
        },
        {
          "name": "Historial de Estados",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/solicitudes/{{solicitud_id}}/historial"
          }
        }
      ]
    },
    {
      "name": "4. Pagos",
      "item": [
        {
          "name": "Iniciar Pago (ciudadano)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('pago_id', json.id);",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Tiene checkout_url', () => pm.expect(json.checkoutUrl).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/pagos/iniciar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": {{solicitud_id}}\n}"
            }
          }
        },
        {
          "name": "Ver Pago por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/pagos/{{pago_id}}"
          }
        },
        {
          "name": "Webhook PlusPagos (confirmación)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('ok: true', () => pm.expect(pm.response.json().ok).to.be.true);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/pagos/webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referencia\": \"SOL-2026-001\",\n  \"estado\": \"APROBADO\",\n  \"monto\": 1500.00,\n  \"transaccionId\": \"PP-TXN-789456\",\n  \"timestamp\": \"2026-02-25T15:00:00Z\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Certificados",
      "item": [
        {
          "name": "Emitir Certificado (gestor)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('cert_id', json.id);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Tiene archivoUrl', () => pm.expect(json.archivoUrl).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/certificados/emitir",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": {{solicitud_id}},\n  \"comentario\": \"Certificado emitido conforme a documentación\"\n}"
            }
          }
        },
        {
          "name": "Ver Certificado",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/certificados/{{cert_id}}"
          }
        },
        {
          "name": "Descargar Certificado (PDF)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Content-Type es PDF', () => {",
                "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/certificados/{{cert_id}}/descargar"
          }
        },
        {
          "name": "Verificar Autenticidad (público)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('valido: true', () => pm.expect(pm.response.json().valido).to.be.true);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/certificados/{{cert_id}}/verificar"
          }
        }
      ]
    },
    {
      "name": "6. Reportes",
      "item": [
        {
          "name": "Resumen General (admin)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Tiene solicitudes', () => pm.expect(pm.response.json().solicitudes).to.be.an('object'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/reportes/resumen"
          }
        }
      ]
    },
    {
      "name": "7. Casos de Error",
      "item": [
        {
          "name": "Sin Token (debe retornar 401)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 401 o 403', () => pm.expect([401,403]).to.include(pm.response.code));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/usuarios/me"
          }
        },
        {
          "name": "Recurso inexistente (debe retornar 404)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 404', () => pm.response.to.have.status(404));",
                "pm.test('Code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/solicitudes/999999"
          }
        },
        {
          "name": "Validación — Login sin body (debe retornar 400)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 400', () => pm.response.to.have.status(400));",
                "pm.test('Code VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    }
  ]
}
